# 复制为 wrangler.toml 后按需修改（wrangler.toml 已在 .gitignore 中，不会入库）
#
# 本文件用于 **Cloudflare Workers** 部署（wrangler deploy）。
# 若要用 **Cloudflare Pages** 部署，同一份代码产出的是 dist/pages/_worker.js，
# 用 `wrangler pages deploy dist/pages --project-name=<项目名>` 部署，
# D1 绑定与变量请在 Pages 项目设置的 Settings → Functions / Variables 中配置
# （Pages 不使用本文件；wrangler 会提示忽略，属预期行为）。

name = "wx-draft-worker"
main = "dist/worker.js"
compatibility_date = "2025-01-01"

# D1 数据库绑定（v2.0.0 起必需：令牌 / 推送记录 / 设置 / 会话）
# 建库：npx wrangler d1 create wx-draft-db  → 把输出的 database_id 填到下面
